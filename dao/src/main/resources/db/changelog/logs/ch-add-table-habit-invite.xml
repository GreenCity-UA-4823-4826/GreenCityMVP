<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="ch-add-table-habit-invite-1" author="GreenCityMVP">
        <createTable tableName="habit_invite">
            <column name="id" autoIncrement="true" type="BIGINT">
                <constraints primaryKey="true"/>
            </column>
            <column name="habit_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="inviter_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="invitee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_date" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="ch-add-table-habit-invite-2" author="GreenCityMVP">
        <addForeignKeyConstraint baseTableName="habit_invite"
                                 baseColumnNames="habit_id"
                                 constraintName="fk_habit_invite_habit"
                                 onDelete="CASCADE"
                                 referencedTableName="habits"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="habit_invite"
                                 baseColumnNames="inviter_id"
                                 constraintName="fk_habit_invite_inviter"
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="habit_invite"
                                 baseColumnNames="invitee_id"
                                 constraintName="fk_habit_invite_invitee"
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="ch-add-table-habit-invite-3" author="GreenCityMVP">
        <createIndex indexName="idx_habit_invite_habit_id" tableName="habit_invite">
            <column name="habit_id"/>
        </createIndex>
        <createIndex indexName="idx_habit_invite_invitee_id" tableName="habit_invite">
            <column name="invitee_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
