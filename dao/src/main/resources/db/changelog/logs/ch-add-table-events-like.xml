<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="ch-add-table-events-like-1" author="GreenCityMVP">
        <createTable tableName="events_like">
            <column name="id" autoIncrement="true" type="BIGINT">
                <constraints primaryKey="true"/>
            </column>
            <column name="created_date" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="event_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="ch-add-table-events-like-2" author="GreenCityMVP">
        <addForeignKeyConstraint baseTableName="events_like"
                                 baseColumnNames="user_id"
                                 constraintName="fk_events_like_user"
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="events_like"
                                 baseColumnNames="event_id"
                                 constraintName="fk_events_like_event"
                                 onDelete="CASCADE"
                                 referencedTableName="events"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="ch-add-table-events-like-3" author="GreenCityMVP">
        <createIndex indexName="idx_events_like_event_id" tableName="events_like">
            <column name="event_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="ch-add-table-events-like-4" author="GreenCityMVP">
        <addUniqueConstraint tableName="events_like"
                             columnNames="event_id, user_id"
                             constraintName="uq_events_like_event_user"/>
    </changeSet>
</databaseChangeLog>
